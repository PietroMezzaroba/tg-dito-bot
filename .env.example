# Copia questo file in `.env` e compila i valori.
#   cp .env.example .env
# `.env` e' gia' in .gitignore: NON committarlo mai.

# --- Discord (obbligatorio) ---
# Discord Developer Portal -> Applications -> Bot -> Reset Token
DISCORD_BOT_TOKEN=il_tuo_token_qui

# --- PostgreSQL (obbligatorio) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=nome_database
DB_USER=utente
DB_PASS=password

# --- Google Gemini (opzionale) ---
# Senza questa chiave il bot funziona; salta solo i messaggi generati.
GOOGLE_API_KEY=
